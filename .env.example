# Metabolic Care Platform — environment template
# Copy to `.env` and fill real values locally. NEVER commit `.env`.
# No real secrets or production values belong in this file.

# ---- App ----
MCP_ENV=dev                       # dev | staging | prod
MCP_DEBUG=true
MCP_API_PREFIX=/api/v1

# ---- Observability ----
MCP_LOG_LEVEL=INFO
MCP_METRICS_ENABLED=true          # exposes /metrics; disable on untrusted edges
MCP_ENABLE_DOCS=true              # Swagger UI /docs + ReDoc /redoc (dev only; FORCED off in prod)

# ---- Audit retention (days by action category) ----
MCP_AUDIT_RETENTION_AUTH_DAYS=365
MCP_AUDIT_RETENTION_DATA_ACCESS_DAYS=730
MCP_AUDIT_RETENTION_ADMIN_DAYS=1095
MCP_AUDIT_RETENTION_DEFAULT_DAYS=365

# ---- Rate limiting & account lockout ----
MCP_RATELIMIT_ENABLED=true
MCP_RATELIMIT_BACKEND=memory          # memory | redis (redis = pluggable, not yet implemented)
MCP_RATELIMIT_AUTH_CAPACITY=20        # max burst per window per client+action
MCP_RATELIMIT_AUTH_WINDOW_SECONDS=60
MCP_LOCKOUT_MAX_FAILURES=5
MCP_LOCKOUT_COOLDOWN_MINUTES=15

# ---- Security (generate strong random values locally) ----
# Min 32 chars for HS256 JWT signing. Generate locally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_SECRET_KEY=dev-insecure-secret-change-me-in-production-0123456789
MCP_ACCESS_TOKEN_TTL_MINUTES=15
MCP_REFRESH_TOKEN_TTL_MINUTES=10080

# Field-level PHI encryption keys (Fernet, comma-separated; first encrypts, all
# decrypt for rotation). Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Dev placeholder below — MUST override in prod via secret manager.
MCP_ENCRYPTION_KEYS=CSuRdJSn8APsbQJ3u91m71ZoHvdpn0IzMj6i7H9kMFg=

# ---- Database ----
# Dev/test default to local SQLite so the stack runs without Postgres.
# Production MUST use PostgreSQL + TimescaleDB.
MCP_DATABASE_URL=sqlite:///./data/mcp_dev.sqlite3
# Example Postgres/TimescaleDB: postgresql+psycopg://mcp:password@localhost:5432/mcp
# When using Postgres, run migrations instead of relying on auto-create:
#   cd backend && alembic upgrade head
# (TimescaleDB hypertable + continuous aggregate are applied by migration 2.)
#
# Optional: point the TimescaleDB integration test at a running instance.
# If unset, that test is skipped (unit/domain tests always run on SQLite).
# MCP_TEST_POSTGRES_URL=postgresql+psycopg://mcp:mcp_dev_only@localhost:5432/mcp

# ---- AI / LLM Gateway (P2 #1) ----
# Default mock mode = NO external LLM calls, NO key required (safe for dev/test).
MCP_AI_MODE=mock                  # mock | gateway
MCP_LLM_GATEWAY_URL=
MCP_LLM_API_KEY=                  # leave empty in dev; inject from secret manager in prod
MCP_LLM_PROVIDER=mock             # mock | openai | anthropic (openai/anthropic = skeleton, no real call)
MCP_LLM_MODEL=mock-vi-1
MCP_LLM_MAX_TOKENS=512
MCP_LLM_TEMPERATURE=0.2
# Per-user cost/rate guard (sliding 60s window) — 429 when exceeded.
MCP_LLM_MAX_REQUESTS_PER_MINUTE=20
MCP_LLM_MAX_TOKENS_PER_MINUTE=20000
# In-memory LRU response cache (identical prompt + user) to cut cost.
MCP_LLM_CACHE_ENABLED=true
MCP_LLM_CACHE_MAX_ENTRIES=512
MCP_LLM_CACHE_TTL_SECONDS=300

# ---- RAG retrieval (P2 #2) ----
MCP_RAG_ENABLED=true
MCP_EMBEDDING_PROVIDER=mock        # mock | openai (openai = skeleton)
MCP_EMBEDDING_DIM=256
MCP_VECTOR_STORE=memory            # memory | pgvector | qdrant (latter two = skeleton)
MCP_RAG_TOP_K=3
MCP_RAG_SEED_DIR=./data/rag_seed

# ---- OCR provider (lab documents) (P2 #3) ----
MCP_OCR_MODE=mock                 # mock | provider
MCP_OCR_PROVIDER_URL=
MCP_OCR_API_KEY=
MCP_OCR_PROVIDER=mock             # mock | tesseract | cloud (latter two = skeleton)
MCP_OCR_WORKER_ENABLED=true
MCP_OCR_QUEUE_MAX_SIZE=256

# ---- Object storage (lab files / reports) ----
MCP_STORAGE_MODE=local            # local | s3 | minio
MCP_STORAGE_LOCAL_DIR=./storage
MCP_S3_ENDPOINT=
MCP_S3_BUCKET=
MCP_S3_ACCESS_KEY=
MCP_S3_SECRET_KEY=
