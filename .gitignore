# ---- Secrets / environment (NEVER commit) ----
.env
.env.*
!.env.example
!.env.internal.example
*.pem
*.key
secrets/
*.secret

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/

# ---- Local data / databases (no real PHI in repo) ----
*.sqlite3
*.db
data/
uploads/
storage/
# Exception: the mobile app's SOURCE storage layer (secure-store adapters + the
# onboarding/install-id modules) is application code, NOT runtime data. The
# unanchored `storage/` rule above otherwise swallows it and breaks EAS builds,
# which check out only the git tree.
!mobile/src/storage/
!mobile/src/storage/**
# Exception: the backend Object Storage ABSTRACTION package (StorageBackend +
# adapters + signed-URL signing) is application code, NOT the runtime blob dir.
# The runtime local blob dir is backend/storage/ (settings.storage_local_dir),
# which stays ignored; only the source package under app/services/ is tracked.
!backend/app/services/storage/
!backend/app/services/storage/**
# …but never the bytecode cache the broad ** negation would otherwise re-include.
backend/app/services/storage/**/__pycache__/
# Exception: the curated RAG seed corpus (approved guideline content, NOT PHI)
# must be version-controlled so fresh checkouts / CI can load it.
!backend/data/
!backend/data/rag_seed/
!backend/data/rag_seed/*.md
# Exception: synthetic regression fixtures (no PHI — generated test data only)
!backend/tests/data/
!backend/tests/data/**

# ---- Node / web (future) ----
node_modules/
.next/
.turbo/

# ---- OS / editor ----
.DS_Store
Thumbs.db
.idea/
.vscode/
*~$*
~$*

# ---- Office lock files ----
~$*.docx

# ---- Claude Code local settings (never commit) ----
.claude/
frontend/tsconfig.tsbuildinfo
backend/.pilot-secrets/
docs/patient-platform-program/evidence/native-j2j5/maestro/

# Native journey screen recordings (large binaries kept as local artifacts; see VIDEO-MANIFEST.md)
docs/patient-platform-program/evidence/**/*.mp4
.gstack/
