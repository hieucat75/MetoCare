# MetoCare Frontend — Environment Variables
# Copy this file to .env.local and fill in the values.

# Backend API base URL (no trailing slash, no /api/v1 suffix — client adds it)
# Default (development): http://localhost:8000/api/v1
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Temporary relaxed authentication policy for the build/test phase (mirrors
# backend MCP_MFA_ENFORCEMENT_ENABLED). Development/staging: false — no role
# is redirected to /mfa-setup. Set true to restore mandatory MFA redirects.
NEXT_PUBLIC_MFA_ENFORCEMENT_ENABLED=false
