# MetoCare VPS — environment variables
# Copy to .env and fill in real values. NEVER commit .env to git.

# PostgreSQL
POSTGRES_PASSWORD=change_me_strong_password_here

# Redis
REDIS_PASSWORD=change_me_redis_password_here

# App secrets (generate with: openssl rand -hex 32)
MCP_SECRET_KEY=change_me_64_char_hex_secret_here

# Fernet key for PHI encryption (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
MCP_ENCRYPTION_KEYS=change_me_fernet_key_here

# Domain (used by nginx + CORS)
DOMAIN=metocare.example.com

# GHCR credentials for pulling image
GHCR_USER=hieucat75
GHCR_TOKEN=ghp_change_me_github_pat_with_read_packages

# Image tag to deploy
IMAGE_TAG=latest
